# Standalone portfolio: all app data and interactions run in the visitor's browser.
VITE_DATA_MODE=demo

# Later, switch to VITE_DATA_MODE=api and redeploy to use the full-stack backend.
# For a separately hosted backend, set the complete API base URL:
# VITE_API_BASE_URL=https://api.example.com/api/v1
# When omitted, API mode uses /api/v1 (Vite proxies /api to localhost:8080 in dev).
