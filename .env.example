# Copy to .env next to docker-compose.yml; `docker compose` reads it automatically.
# Every value has a safe local default, so the file is optional on your own machine.

# Password of the bundled PostgreSQL database.
DB_PASSWORD=skillhub

# HS256 signing key for login tokens (at least 32 characters). Always replace it outside local use.
JWT_SECRET=compose-local-secret-change-me-in-production-32+

# Browser origins allowed to call the API directly. The Docker web app on :3000 needs none (same origin);
# the defaults cover `npm run dev` in API mode.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seeds 30 fictional learners (including demo@skillhub.dev / gece2025) into an empty database, once.
DEMO_DATA_ENABLED=true

# Optional: turns on the Claude-powered Gece Rehberi. Without a key the rule-based guide answers.
ANTHROPIC_API_KEY=

# Model used by the Gece Rehberi when ANTHROPIC_API_KEY is set.
GUIDE_MODEL=claude-opus-5-5
